<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="everypay" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Everypay (pay with Credit/Debit card)</label>

                <field id="title" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="merchant_secret_key" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Secret Api Key</label>
                </field>
                <field id="merchant_public_key" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Public  Api Key</label>
                </field>
                <field id="sandbox" translate="label" type="select" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sandbox Mode</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="installments" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Installments Plan</label>
                    <tooltip><![CDATA[Create your installments plan here <br>using the following format: <br>number_of_installments;up_to_amount,number_of_installments;up_to_amount<br> eg.: 2;100,3;200,4;300]]></tooltip>
                </field>
                <field id="payment_action" translate="label" type="select" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment Action</label>
                    <source_model>Everypay\Everypay\Model\Adminhtml\Source\PaymentAction</source_model>
                </field>
                <field id="allowspecific" translate="label" type="allowspecific" sortOrder="130" showInDefault="9"
                       showInWebsite="1" showInStore="0">
                    <label>Payment From Applicable Countries</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="140" showInDefault="1"
                       showInWebsite="1" showInStore="0">
                    <label>Payment From Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="160" showInDefault="1" showInWebsite="1"
                       showInStore="0">
                    <label>Sort Order</label>
                    <frontend_class>validate-number</frontend_class>
                </field>

                <!-- Google Play settings begin -->
                <field id="googlepay_feature" translate="label" type="select" sortOrder="170" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google Pay</label>
                    <comment><![CDATA[⚠️ Please contact Support to Enable/Disable Google Pay Payments Processing]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="googlepay_country_code" translate="label" type="select" sortOrder="171" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Country</label>
                    <comment><![CDATA[Billing country for Google Pay]]></comment>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="googlepay_feature">1</field>
                    </depends>
                </field>
                <field id="googlepay_merchant_name" translate="label" type="text" sortOrder="172" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Name</label>
                    <comment><![CDATA[The name to be displayed on the payform modal]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="googlepay_feature">1</field>
                    </depends>
                </field>
                <field id="googlepay_merchant_url" translate="label" type="text" sortOrder="173" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant URL</label>
                    <comment><![CDATA[Your store URL (e.g. https://my-store.com)]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="googlepay_feature">1</field>
                    </depends>
                </field>
                <field id="googlepay_allowed_card_networks" translate="label" type="text" sortOrder="174" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allowed Card Networks</label>
                    <comment><![CDATA[Comma-separated (e.g. VISA,MASTERCARD)]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="googlepay_feature">1</field>
                    </depends>
                </field>
                <field id="googlepay_allowed_auth_methods" translate="label" type="text" sortOrder="175" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allowed Auth Methods</label>
                    <comment><![CDATA[Comma-separated (e.g. CRYPTOGRAM_3DS,PAN_ONLY)]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="googlepay_feature">1</field>
                    </depends>
                </field>
                <field id="googlepay_button_color" translate="label" type="text" sortOrder="176" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Color</label>
                    <comment><![CDATA[Available options are black or white]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="googlepay_feature">1</field>
                    </depends>
                </field>
                <!-- Google Play settings end -->

                <!-- Apple Play settings begin -->
                <field id="applepay_feature" translate="label" type="select" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Apple Pay</label>
                    <comment><![CDATA[⚠️ Please contact Support to Enable/Disable Apple Pay Payments Processing]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="applepay_country_code" translate="label" type="select" sortOrder="201" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Country</label>
                    <comment><![CDATA[Billing country for Apple Pay]]></comment>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="applepay_feature">1</field>
                    </depends>
                </field>
                <field id="applepay_merchant_name" translate="label" type="text" sortOrder="202" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant Name</label>
                    <comment><![CDATA[The name to be displayed on the payform modal]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="applepay_feature">1</field>
                    </depends>
                </field>
                <field id="applepay_merchant_url" translate="label" type="text" sortOrder="203" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Merchant URL</label>
                    <comment><![CDATA[Your store URL (e.g. https://my-store.com)]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="applepay_feature">1</field>
                    </depends>
                </field>

                <field id="applepay_register_merchant_url" translate="label" type="button" sortOrder="204" showInDefault="1" showInWebsite="1" showInStore="1">
                    <!-- <label>Register Merchant URL</label> -->
                    <frontend_model>Everypay\Everypay\Block\System\Config\RegisterMerchantUrl</frontend_model>
                    <depends>
                        <field id="applepay_feature">1</field>
                    </depends>
                </field>

                <field id="applepay_allowed_card_networks" translate="label" type="text" sortOrder="205" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allowed Card Networks</label>
                    <comment><![CDATA[Comma-separated (e.g. VISA,MASTERCARD)]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="applepay_feature">1</field>
                    </depends>
                </field>
                <field id="applepay_button_color" translate="label" type="text" sortOrder="206" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Color</label>
                    <comment><![CDATA[Available options are black or white]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="applepay_feature">1</field>
                    </depends>
                </field>
                <!-- Apple Play settings end -->

                <!-- IRIS settings begin -->
                <field id="iris_feature" translate="label" type="select" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>IRIS</label>
                    <comment><![CDATA[⚠️ Enable IRIS bank payment method]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="iris_merchant_name" translate="label" type="text" sortOrder="201" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>IRIS Merchant Name</label>
                    <comment><![CDATA[The name to be displayed in the IRIS payment flow]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="iris_feature">1</field>
                    </depends>
                </field>
                <field id="iris_country" translate="label" type="select" sortOrder="202" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>IRIS Country</label>
                    <comment><![CDATA[Country for IRIS payments]]></comment>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="iris_feature">1</field>
                    </depends>
                </field>
                <!-- IRIS settings end -->
            </group>
        </section>
    </system>
</config>

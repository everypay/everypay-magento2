<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <everypay>
                <debug>1</debug>
                <active>0</active>
                <model>EverypayEverypayFacade</model>
                <merchant_gateway_key backend_model="Magento\Config\Model\Config\Backend\Encrypted" />
                <order_status>pending_payment</order_status>
                <payment_action>authorize</payment_action>
                <title>Everypay</title>
                <currency>USD</currency>
                <can_authorize>1</can_authorize>
                <can_capture>1</can_capture>
                <can_void>1</can_void>
                <can_use_checkout>1</can_use_checkout>
                <is_gateway>1</is_gateway>
                <sort_order>1</sort_order>
                <debugReplaceKeys>MERCHANT_KEY</debugReplaceKeys>
                <paymentInfoKeys>FRAUD_MSG_LIST</paymentInfoKeys>
                <privateInfoKeys>FRAUD_MSG_LIST</privateInfoKeys>
                <googlepay_feature>0</googlepay_feature>
                <googlepay_country_code>US</googlepay_country_code>
                <googlepay_merchant_name>MerchantName</googlepay_merchant_name>
                <googlepay_merchant_url></googlepay_merchant_url>
                <googlepay_allowed_card_networks>VISA,MASTERCARD</googlepay_allowed_card_networks>
                <googlepay_allowed_auth_methods>CRYPTOGRAM_3DS,PAN_ONLY</googlepay_allowed_auth_methods>
                <googlepay_button_color>black</googlepay_button_color>
                <applepay_feature>0</applepay_feature>
                <applepay_country_code>US</applepay_country_code>
                <applepay_merchant_name>MerchantName</applepay_merchant_name>
                <applepay_merchant_url></applepay_merchant_url>
                <applepay_allowed_card_networks>VISA,MASTERCARD</applepay_allowed_card_networks>
                <applepay_button_color>black</applepay_button_color>
            </everypay>
        </payment>
    </default>
</config>
